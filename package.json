{
  "name": "@theatre/client",
  "private": true,
  "version": "1.3.0",
  "license": "AGPL-3.0",
  "type": "module",
  "packageManager": "npm@12.2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "oxlint .",
    "ci": "commitlint --from main --to HEAD && npm run format:check && npm run lint && npm run typecheck",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/node": "^22.7.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.2",
    "dotenv": "^18.0.7",
    "husky": "^9.1.7",
    "oxlint": "^1.87.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9",
    "typescript": "^5.6.3",
    "vite": "^5.4.8"
  }
}
